# Public site URL (used for canonical URLs, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://kakahospital.com

# Appointment form delivery — set ONE of these. With neither set, requests are only logged server-side.
# Resend (https://resend.com)
RESEND_API_KEY=
APPOINTMENT_EMAIL_TO=kkhospital18@gmail.com
APPOINTMENT_EMAIL_FROM=KK Hospital Website <appointments@kakahospital.com>
# Formspree (https://formspree.io) — full endpoint URL, e.g. https://formspree.io/f/abcdwxyz
FORMSPREE_ENDPOINT=

# Optional: WhatsApp notification webhook (e.g. WhatsApp Cloud API relay / Interakt / Wati). Receives JSON POST.
WHATSAPP_WEBHOOK_URL=
